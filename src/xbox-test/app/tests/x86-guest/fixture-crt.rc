// Embeds fixture-crt.manifest as the fixture's application manifest. The
// supportedOS entry makes GetVersionEx report 10.0 under real Windows (and
// Wine), matching what the console reports and what the interpreter answers.
1 24 "fixture-crt.manifest"
101 RCDATA { 0x12345678L }
202 RCDATA { 0x87654321L }
"Alpha" RCDATA { 0x11111111L }
"Beta" RCDATA { 0x22222222L }
STRINGTABLE
BEGIN
    0 "Zero slot"
    7 "Pug resource"
END
