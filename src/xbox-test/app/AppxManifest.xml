<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">
  <Identity Name="Xboxnative.Launcher" Publisher="CN=xboxnative-dev" Version="0.5.225.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Xbox Native</DisplayName>
    <PublisherDisplayName>xboxnative-dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="App" Executable="xbtest.exe" EntryPoint="xbtest.App">
      <uap:VisualElements DisplayName="Xbox Native" Description="Steam QR login + library"
        BackgroundColor="#0E1116" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E1116" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="codeGeneration" />
    <uap:Capability Name="removableStorage" />
    <!-- The library names the signed-in Xbox user and shows their picture.
         Per the capability reference this is a uap-namespaced restricted
         capability ("gives apps the ability to access the user's name and
         picture"); without it the user queries come back empty on the console
         and the sidebar falls back to the Steam persona. -->
    <uap:Capability Name="userAccountInformation" />
  </Capabilities>
</Package>
