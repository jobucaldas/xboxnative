From: xboxnative contributors
Subject: [PATCH] donor DLLs: use public critical-section flags
SPDX-License-Identifier: LGPL-2.1-or-later

Initialize donor critical sections with the documented flags value. Wine's
FORCE_DEBUG_INFO flag is ntdll-internal and may be rejected by the console's
InitializeCriticalSectionEx implementation. DebugInfo may also be NULL or
(PVOID)-1, so donor-only annotations must tolerate both values.

--- a/dlls/msvcp90/misc.c
+++ b/dlls/msvcp90/misc.c
@@ -264,8 +264,8 @@
 mutex* __thiscall mutex_ctor(mutex *this)
 {
     CRITICAL_SECTION *cs = operator_new(sizeof(*cs));
-    InitializeCriticalSectionEx(cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
-    cs->DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": _Mutex critical section");
+    InitializeCriticalSectionEx(cs, 0, 0);
+    if (cs->DebugInfo && cs->DebugInfo != (void *)-1) cs->DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": _Mutex critical section");
     this->mutex = cs;
     return this;
 }
@@ -275,7 +275,7 @@
 DEFINE_THISCALL_WRAPPER(mutex_dtor, 4)
 void __thiscall mutex_dtor(mutex *this)
 {
-    ((CRITICAL_SECTION*)this->mutex)->DebugInfo->Spare[0] = 0;
+    if (((CRITICAL_SECTION*)this->mutex)->DebugInfo && ((CRITICAL_SECTION*)this->mutex)->DebugInfo != (void *)-1) ((CRITICAL_SECTION*)this->mutex)->DebugInfo->Spare[0] = 0;
     DeleteCriticalSection(this->mutex);
     operator_delete(this->mutex);
 }
@@ -347,8 +347,8 @@
     {
         for(i=0; i<_MAX_LOCK; i++)
         {
-            InitializeCriticalSectionEx(&lockit_cs[i], 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
-            lockit_cs[i].DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": _Lockit critical section");
+            InitializeCriticalSectionEx(&lockit_cs[i], 0, 0);
+            if (lockit_cs[i].DebugInfo && lockit_cs[i].DebugInfo != (void *)-1) lockit_cs[i].DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": _Lockit critical section");
         }
     }
     init_locks++;
@@ -376,7 +376,7 @@
     {
         for(i=0; i<_MAX_LOCK; i++)
         {
-            lockit_cs[i].DebugInfo->Spare[0] = 0;
+            if (lockit_cs[i].DebugInfo && lockit_cs[i].DebugInfo != (void *)-1) lockit_cs[i].DebugInfo->Spare[0] = 0;
             DeleteCriticalSection(&lockit_cs[i]);
         }
     }
