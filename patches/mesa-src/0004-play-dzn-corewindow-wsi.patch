+       * Play: without a DirectComposition device (the console has none) the
+       * swapchain is created for the guest HWND, which the launcher maps to
+       * its CoreWindow. A CoreWindow swapchain needs at least three flip
+       * buffers, and the image count must match the buffer count because
+       * acquire indexes the images by the swapchain's back buffer index.
        */
-      caps->minImageCount = caps->maxImageCount = 2;
+      struct wsi_win32 *wsi =
+         (struct wsi_win32 *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_WIN32];
+      caps->minImageCount = caps->maxImageCount = wsi && !wsi->dxgi.dcomp ? 3 : 2;
    } else {
       caps->minImageCount = 1;
       /* Software callbacke, there is no real maximum */
@@ -698,12 +706,13 @@
       break;
    }
 
-   if (chain->surface->current_swapchain != chain) {
+   /* Play: with no DirectComposition device the swapchain is bound to the
+    * window directly, so Present above is the whole of presentation. */
+   if (chain->wsi->dxgi.dcomp && chain->surface->current_swapchain != chain) {
       chain->surface->visual->SetContent(chain->dxgi);
       chain->wsi->dxgi.dcomp->Commit();
       chain->surface->current_swapchain = chain;
    }
-
    /* Mark the other image idle */
    chain->status = VK_SUCCESS;
    return VK_SUCCESS;
@@ -792,12 +801,26 @@
       desc.BufferUsage |= DXGI_USAGE_RENDER_TARGET_OUTPUT;
 
