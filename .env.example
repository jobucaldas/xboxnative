# Copy to .env (git-ignored) and fill in. Never commit .env. Placeholders only.
# Read by ./xn (see docs/BUILD-AND-TEST.md); the names are the ones src/xbox-test/dp/dp-lib.sh already uses.

# Device Portal of the console (Dev Mode). A bare host or a URL, e.g. https://192.0.2.10 or https://xbox.example:11443
DP_HOST=https://192.0.2.10
# Device Portal credentials. DP_PASS is never printed or logged.
DP_USER=your-device-portal-user
DP_PASS=change-me

# Optional
# DP_PORT=11443                  # wins over a port inside DP_HOST
# DP_SOCKS=localhost:1055        # SOCKS5 proxy (e.g. a tailnet); set it empty (DP_SOCKS=) to connect directly
# DP_LOCK=/path/to/CONSOLE.lock  # console lock shared by every session that uses this console
# UWP_CROSSBUILD=/path/to/uwp-crossbuild   # checkout made by src/tools/fetch-uwp-crossbuild.sh
